# ── Database ───────────────────────────────────────────────
# Local dev uses the bundled docker-compose Postgres (port 5433).
DATABASE_URL="postgresql://medibook:medibook@localhost:5433/medibook?schema=public"

# ── Auth.js ────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── OTP / SMS ──────────────────────────────────────────────
# Leave SMS_PROVIDER=console in dev: OTPs are printed to the server log.
SMS_PROVIDER="console"          # console | twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ── Email ──────────────────────────────────────────────────
EMAIL_PROVIDER="console"        # console | resend
RESEND_API_KEY=""
EMAIL_FROM="MediBook <no-reply@medibook.pk>"

# ── Payments ───────────────────────────────────────────────
# mock = a sandbox checkout page inside the app; no real money moves.
PAYMENT_PROVIDER="mock"         # mock | jazzcash | easypaisa | stripe
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Ops ────────────────────────────────────────────────────
PLATFORM_FEE_PERCENT="0"          # commission on online payments, percent of fee
UNPAID_BOOKING_TTL_MINUTES="20"   # unpaid online bookings released after this
CRON_SECRET="replace-me"        # protects /api/cron/* endpoints
TZ_DEFAULT="Asia/Karachi"
